{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm format\\:check)",
      "Bash(pnpm tsc --noEmit)",
      "Bash(pnpm tsc:*)",
      "Bash(pnpm test\\:run)",
      "Bash(pnpm test\\:coverage)",
      "Bash(pnpm vitest run:*)",
      "Bash(pnpm build-storybook)",
      "Bash(pnpm biome check)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Skill(component-creator)",
      "Skill(zustand-pattern)",
      "Skill(tdd-patterns)",
      "Skill(ci-check)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-ci-check.sh"
          }
        ]
      }
    ]
  }
}
